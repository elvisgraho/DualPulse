<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualPulse.App.ViewModels"
        x:Class="DualPulse.App.Views.FirstStartWindow"
        x:DataType="vm:FirstStartViewModel"
        Title="Welcome to DualPulse"
        Icon="/Assets/dualpulse.ico"
        Width="440" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
  <StackPanel Spacing="12" Margin="24">
    <TextBlock Classes="caption" Text="GET STARTED" />
    <TextBlock Classes="subtitle" TextWrapping="Wrap" Text="How should games see your controller?" />
    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" Background="Transparent">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- No hover or press effects; the picked option is shown by its border. -->
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.caption.ready">
          <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>
        <Style Selector="ListBoxItem Border.choice">
          <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.choice">
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SetupChoice">
          <Border Classes="choice" Background="{StaticResource Surface}" BorderThickness="2"
                  CornerRadius="{StaticResource ControlRadius}" Padding="12,8">
            <Grid ColumnDefinitions="*,8,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Detail}" />
                <TextBlock Classes="caption" Classes.ready="{Binding Ready}" Text="{Binding Status}" />
              </StackPanel>
              <Button Grid.Column="2" VerticalAlignment="Center" Content="Get"
                      Command="{Binding $parent[ListBox].((vm:FirstStartViewModel)DataContext).GetDriverCommand}"
                      CommandParameter="{Binding}" IsVisible="{Binding !Ready}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid ColumnDefinitions="*,8,Auto">
      <StackPanel Spacing="2">
        <TextBlock Text="Hide your DualSense from games" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="Recommended with a virtual controller, so games don't see two." />
        <TextBlock Classes="caption" Classes.ready="{Binding HidHideReady}" Text="{Binding HidHideStatus}" />
      </StackPanel>
      <Button Grid.Column="2" VerticalAlignment="Center" Content="Get" Command="{Binding GetHidHideCommand}" IsVisible="{Binding !HidHideReady}" />
    </Grid>
    <TextBlock Classes="caption" TextWrapping="Wrap" Text="You can change this any time on the Emulation page." />
  </StackPanel>
</Window>
