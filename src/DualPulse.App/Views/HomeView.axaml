<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualPulse.App.ViewModels"
             xmlns:views="using:DualPulse.App.Views"
             xmlns:controls="using:DualPulse.App.Controls"
             xmlns:core="using:DualPulse.Core.Protocol"
             x:Class="DualPulse.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Panel>
  <Grid ColumnDefinitions="3*,24,2*">
    <!-- Live controller -->
    <Border Grid.Column="0" Classes="card">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Classes="subtitle" Text="Controller" />
        <controls:ControllerView Grid.Row="1" Margin="0,16,0,0" Snapshot="{Binding Snapshot}" Cabled="{Binding IsCabled}"
                                 Opacity="{Binding IsConnected, Converter={x:Static views:Converters.ConnectedOpacity}}">
          <controls:ControllerView.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
          </controls:ControllerView.Transitions>
        </controls:ControllerView>
        <!-- Always takes its space, so the drawing above doesn't grow or shrink when the controller comes and goes. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
          <TextBlock Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DeviceSummary}"
                     IsVisible="{Binding IsConnected}" />
          <TextBlock Classes="secondary" VerticalAlignment="Center" Text="Not connected" IsVisible="{Binding !IsConnected}" />
          <Button Grid.Column="1" Content="Details" Command="{Binding ShowDeviceInfoCommand}" IsEnabled="{Binding IsConnected}"
                  Opacity="{Binding IsConnected, Converter={x:Static views:Converters.ShownOpacity}}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Status and quick actions -->
    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="12">
        <Border Classes="card" IsVisible="{Binding ShowSteamInput}">
          <StackPanel Spacing="12">
            <TextBlock Classes="caption" Text="STEAM INPUT" />
            <TextBlock TextWrapping="Wrap" Text="{Binding SteamInputText}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="In Steam: the game's Properties, Controller, Disable Steam Input." />
            <Button Content="Open in Steam" Command="{Binding OpenInSteamCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card status" Classes.connected="{Binding IsConnected}">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="CONNECTION" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="indicator" Width="8" Height="8" VerticalAlignment="Center" />
              <TextBlock Classes="subtitle" Text="{Binding ConnectionText}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card status">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="BATTERY" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="subtitle" Text="{Binding BatteryPercent, StringFormat={}{0}%}" IsVisible="{Binding IsConnected}" />
              <TextBlock Classes="subtitle secondary" Text="—" IsVisible="{Binding !IsConnected}" />
              <TextBlock Classes="secondary" VerticalAlignment="Center" Text="Charging" IsVisible="{Binding IsCharging}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card status">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="EMULATION" />
            <TextBlock Classes="subtitle" Text="{Binding EmulationText}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="caption" Text="QUICK ACTIONS" />
            <StackPanel Spacing="8" IsVisible="{Binding ShowProfilePicker}">
              <TextBlock Classes="secondary" Text="Profile" />
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NamedProfiles}" SelectedItem="{Binding ChosenProfile}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="secondary" Text="Lightbar" />
              <ItemsControl ItemsSource="{Binding LightbarSwatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SwatchChoice">
                    <Border Classes="swatch-ring" Classes.selected="{Binding Selected}">
                      <Button Classes="swatch" Background="{Binding Colour, Converter={x:Static views:Converters.RgbToBrush}}"
                              Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).SetLightbarCommand}"
                              CommandParameter="{Binding Colour}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="secondary" Text="Adaptive triggers" />
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TriggerPresets}"
                        SelectedItem="{Binding SelectedTriggerPreset}" PlaceholderText="Custom" />
            </StackPanel>
            <Button Content="Turn controller off" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding PowerOffCommand}" ToolTip.Tip="Bluetooth only" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- Controller details over Home; closes with Close or a click beside the card. -->
  <Panel IsVisible="{Binding DeviceInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Border Background="#99000000" PointerPressed="OnBackdropPressed" />
    <Border Classes="card" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
            DataContext="{Binding DeviceInfo}" x:DataType="vm:DeviceInfoViewModel">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="CONTROLLER DETAILS" />
          <Button Grid.Column="1" Content="Close" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).CloseDeviceInfoCommand}" />
        </Grid>
        <TextBlock Classes="secondary" Text="Connect your controller." IsVisible="{Binding !IsConnected}" />
        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsConnected}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DeviceInfoRow">
              <Grid ColumnDefinitions="140,*" Margin="0,0,0,8">
                <TextBlock Classes="secondary" Text="{Binding Label}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Content="Copy" Command="{Binding CopyCommand}" />
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding CopyStatus}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
  </Panel>
</UserControl>
