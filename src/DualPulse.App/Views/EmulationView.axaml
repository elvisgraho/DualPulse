<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualPulse.App.ViewModels"
             x:Class="DualPulse.App.Views.EmulationView"
             x:DataType="vm:EmulationViewModel">
  <ScrollViewer>
    <!-- Content fills the width up to 720 px and stays left-aligned. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="720" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    <StackPanel Spacing="16" Margin="0,0,16,0">
      <TextBlock Classes="title" Text="Emulation" />

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="caption" Text="VIRTUAL CONTROLLER" />
          <Grid ColumnDefinitions="*,16,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="What games see" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Native: games use your DualSense as it is." />
            </StackPanel>
            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center"
                      ItemsSource="{Binding EmulationChoices}" SelectedItem="{Binding SelectedEmulation}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EmulationChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ShowDualSenseHint}"
                     Text="Games with DualSense support get adaptive triggers, lights and vibration, also over Bluetooth. Works best with Hide my DualSense on." />
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowDualSenseHint}">
            <StackPanel Spacing="2">
              <TextBlock Text="Game sound on the controller speaker" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Plays a game's controller sounds on the controller's speaker." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center" IsChecked="{Binding GameSoundOnController}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="Status" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding StatusText}" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ShowSteamHint}"
                     Text="Steam is running. If a game ignores your triggers or lights, turn off Steam Input for it: in Steam, the game's Properties, Controller." />
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowViGEmBus}">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding DriverText}" />
            <Button Grid.Column="2" Content="Get ViGEmBus" Command="{Binding GetViGEmBusCommand}" IsVisible="{Binding DriverMissing}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowUsbIp}">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding UsbIpText}" />
            <Button Grid.Column="2" Content="Get usbip-win2" Command="{Binding GetUsbIpCommand}" IsVisible="{Binding UsbIpMissing}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowRemaps}">
        <StackPanel Spacing="12">
          <TextBlock Classes="caption" Text="BUTTONS IN GAMES" />
          <TextBlock Classes="secondary" Text="Buttons work as usual." IsVisible="{Binding !Remaps.Count}" />
          <ItemsControl ItemsSource="{Binding Remaps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RemapRow">
                <Grid ColumnDefinitions="*,12,Auto,12,*,8,Auto">
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FromChoices}" SelectedItem="{Binding From}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ButtonChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="secondary" Text="sends" />
                  <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" ItemsSource="{Binding ToChoices}" SelectedItem="{Binding To}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ButtonChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="6" Content="Remove" Command="{Binding RemoveCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Change a button" Command="{Binding AddRemapCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="caption" Text="HIDE THE DUALSENSE" />
          <Grid ColumnDefinitions="*,16,Auto" IsEnabled="{Binding CanToggleHide}">
            <StackPanel Spacing="2">
              <TextBlock Text="Hide my DualSense from other apps" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Games then see only the virtual controller. Stays on after DualPulse closes." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center"
                          IsChecked="{Binding HideController}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding HideStatusText}" />
            <Button Grid.Column="2" Content="Get HidHide" Command="{Binding GetHidHideCommand}" IsVisible="{Binding HidHideMissing}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
