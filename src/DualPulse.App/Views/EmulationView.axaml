<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualPulse.App.ViewModels"
             x:Class="DualPulse.App.Views.EmulationView"
             x:DataType="vm:EmulationViewModel">
  <UserControl.Styles>
    <!-- PlayStation button symbols, drawn: the text characters look uneven between fonts. -->
    <Style Selector="Path.button-symbol">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.button-letter">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <!-- Content fills the width up to 720 px and stays left-aligned. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="720" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    <StackPanel Spacing="16" Margin="0,0,16,0">
      <TextBlock Classes="title" Text="Emulation" />

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="caption" Text="VIRTUAL CONTROLLER" />
          <Grid ColumnDefinitions="*,16,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="What games see" />
              <ItemsControl ItemsSource="{Binding ModePoints}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StringFormat='• {0}'}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center"
                      ItemsSource="{Binding EmulationChoices}" SelectedItem="{Binding SelectedEmulation}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EmulationChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ShowDualSenseHint}"
                     Text="Works best with Hide my DualSense on." />
          <WrapPanel IsVisible="{Binding ShowXboxButtonTip}" ItemSpacing="16" LineSpacing="4">
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="Games show Xbox buttons:" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="caption button-letter" Text="A" />
              <Path Classes="button-symbol" Stroke="#7FA8E8" Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="caption button-letter" Text="B" />
              <Path Classes="button-symbol" Stroke="#F0707A" Data="M1.5,6 A4.5,4.5 0 1 1 10.5,6 A4.5,4.5 0 1 1 1.5,6 Z" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="caption button-letter" Text="X" />
              <Path Classes="button-symbol" Stroke="#E28FC6" Data="M2,2 H10 V10 H2 Z" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="caption button-letter" Text="Y" />
              <Path Classes="button-symbol" Stroke="#4FC9A3" Data="M6,1.5 L10.8,10 H1.2 Z" />
            </StackPanel>
          </WrapPanel>
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowDualSenseHint}">
            <StackPanel Spacing="2">
              <TextBlock Text="Game sound on the controller speaker" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Plays a game's controller sounds on the controller's speaker." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center" IsChecked="{Binding GameSoundOnController}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowDualSenseHint}">
            <StackPanel Spacing="2">
              <TextBlock Text="Sound device for games" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Off: no extra sound device in Windows; games lose haptics, the speaker and the microphone." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center" IsChecked="{Binding VirtualSoundDevice}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowDualSenseHint}">
            <StackPanel Spacing="2">
              <TextBlock Text="Game sets the lights" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Off: your lightbar and player LEDs stay." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center" IsChecked="{Binding GameLights}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowDualSenseHint}">
            <StackPanel Spacing="2">
              <TextBlock Text="Game sets the adaptive triggers" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Off: your trigger settings stay." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center" IsChecked="{Binding GameTriggers}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="Status" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding StatusText}" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ShowSteamHint}"
                     Text="Steam is running. If a game ignores your triggers or lights, turn off Steam Input for it: in Steam, the game's Properties, Controller." />
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowViGEmBus}">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding DriverText}" />
            <Button Grid.Column="2" Content="Get ViGEmBus" Command="{Binding GetViGEmBusCommand}" IsVisible="{Binding DriverMissing}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowUsbIp}">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding UsbIpText}" />
            <Button Grid.Column="2" Content="Get usbip-win2" Command="{Binding GetUsbIpCommand}" IsVisible="{Binding UsbIpMissing}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowRemaps}">
        <StackPanel Spacing="12">
          <TextBlock Classes="caption" Text="BUTTONS IN GAMES" />
          <TextBlock Classes="secondary" Text="Buttons work as usual." IsVisible="{Binding !Remaps.Count}" />
          <ItemsControl ItemsSource="{Binding Remaps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RemapRow">
                <Grid ColumnDefinitions="*,12,Auto,12,*,8,Auto">
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FromChoices}" SelectedItem="{Binding From}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ButtonChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="secondary" Text="sends" />
                  <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" ItemsSource="{Binding ToChoices}" SelectedItem="{Binding To}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ButtonChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="6" Content="Remove" Command="{Binding RemoveCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Change a button" Command="{Binding AddRemapCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="caption" Text="HIDE THE DUALSENSE" />
          <Grid ColumnDefinitions="*,16,Auto" IsEnabled="{Binding CanToggleHide}">
            <StackPanel Spacing="2">
              <TextBlock Text="Hide my DualSense from other apps" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Games then see only the virtual controller. Stays on after DualPulse closes." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center"
                          IsChecked="{Binding HideController}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding HideStatusText}" />
            <Button Grid.Column="2" Content="Get HidHide" Command="{Binding GetHidHideCommand}" IsVisible="{Binding HidHideMissing}" />
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowReconnect}">
            <StackPanel Spacing="2">
              <TextBlock Text="A game sees two controllers?" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ReconnectStatus}"
                         IsVisible="{Binding ReconnectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="2" VerticalAlignment="Center" Content="Reconnect controller" Command="{Binding ReconnectCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
