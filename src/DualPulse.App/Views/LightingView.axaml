<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualPulse.App.ViewModels"
             xmlns:views="using:DualPulse.App.Views"
             xmlns:core="using:DualPulse.Core.Protocol"
             x:Class="DualPulse.App.Views.LightingView"
             x:DataType="vm:LightingViewModel">
  <ScrollViewer>
    <!-- Content fills the width up to 720 px and stays left-aligned. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="720" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    <StackPanel Spacing="16" Margin="0,0,16,0">
      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="caption" Text="LIGHTBAR" />
          <!-- Live preview of what the controller shows, animated modes included. -->
          <Border Height="12" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1"
                  Background="{Binding Preview, Converter={x:Static views:Converters.RgbToBrush}}" />

          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock VerticalAlignment="Center" Text="Mode" />
            <ComboBox Grid.Column="2" MinWidth="180" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModeChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="Auto,16,*,16,40">
            <TextBlock VerticalAlignment="Center" Text="Brightness" />
            <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Brightness}" />
            <TextBlock Grid.Column="4" Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding Brightness, StringFormat={}{0}%}" />
          </Grid>

          <StackPanel Spacing="12" IsEnabled="{Binding ColourApplies}">
            <TextBlock Text="Colour" />
            <ItemsControl ItemsSource="{Binding Swatches}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SwatchChoice">
                  <Border Classes="swatch-ring" Classes.selected="{Binding Selected}">
                    <Button Classes="swatch" Background="{Binding Colour, Converter={x:Static views:Converters.RgbToBrush}}"
                            Command="{Binding $parent[ItemsControl].((vm:LightingViewModel)DataContext).SetColourCommand}"
                            CommandParameter="{Binding Colour}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,12,Auto,12,Auto">
              <TextBlock Grid.Row="0" VerticalAlignment="Center" Classes="secondary" Text="Hue" />
              <Slider Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="359" Value="{Binding Hue}" />
              <TextBlock Grid.Row="2" VerticalAlignment="Center" Classes="secondary" Text="Saturation" />
              <Slider Grid.Row="2" Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Saturation}" />
              <TextBlock Grid.Row="4" VerticalAlignment="Center" Classes="secondary" Text="Hex" />
              <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <TextBox Width="120" Text="{Binding HexColour}" Classes.invalid="{Binding HexInvalid}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="Use #RRGGBB" IsVisible="{Binding HexInvalid}" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <TextBlock Classes="caption" Text="Rainbow and Battery modes choose their own colours." IsVisible="{Binding !ColourApplies}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="caption" Text="PLAYER LEDS" />
          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock VerticalAlignment="Center" Text="Pattern" />
            <ComboBox Grid.Column="2" MinWidth="180" ItemsSource="{Binding PlayerLedChoices}" SelectedItem="{Binding SelectedPlayerLeds}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlayerLedChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto">
            <TextBlock VerticalAlignment="Center" Text="Brightness" />
            <ComboBox Grid.Column="2" MinWidth="180" ItemsSource="{Binding PlayerLedBrightnessChoices}" SelectedItem="{Binding SelectedPlayerLedBrightness}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LedBrightnessChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,16,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Flash on low battery" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="At 10% and below, while not charging." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" IsChecked="{Binding LowBatteryFlash}" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
