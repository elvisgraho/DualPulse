<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualPulse.App.ViewModels"
        x:Class="DualPulse.App.Views.DeviceInfoWindow"
        x:DataType="vm:DeviceInfoViewModel"
        Title="Controller details"
        Icon="/Assets/dualpulse.ico"
        Width="400" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">
  <StackPanel Spacing="16" Margin="24">
    <TextBlock Classes="caption" Text="CONTROLLER DETAILS" />
    <TextBlock Classes="secondary" Text="Connect your controller." IsVisible="{Binding !IsConnected}" />
    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsConnected}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DeviceInfoRow">
          <Grid ColumnDefinitions="140,*" Margin="0,0,0,8">
            <TextBlock Classes="secondary" Text="{Binding Label}" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Copy" Command="{Binding CopyCommand}" />
      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding CopyStatus}" />
    </StackPanel>
  </StackPanel>
</Window>
