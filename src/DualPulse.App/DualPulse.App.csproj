<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\DualPulse.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DualPulse.App</RootNamespace>
    <AssemblyName>DualPulse</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.4.2</Version>
    <!-- The exe's own icon (Explorer, taskbar, shortcuts); windows set theirs in XAML. -->
    <ApplicationIcon>Assets\dualpulse.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DualPulse.Core\DualPulse.Core.csproj" />
    <ProjectReference Include="..\DualPulse.Emulation\DualPulse.Emulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DualPulse.App.Tests" />
  </ItemGroup>
</Project>
