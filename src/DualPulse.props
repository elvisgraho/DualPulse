<Project>
  <!-- Shared settings for the DualPulse projects. Imported explicitly by each project. Plain net10.0 so Core and App build on any OS; Windows-only code is marked
       [SupportedOSPlatform("windows")] and the platform analyzer (CA1416, an error here) keeps calls to it guarded. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <!-- Built on Windows, the app stays a win-x64 build as before; elsewhere pass -r (e.g. -r linux-x64). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
</Project>
