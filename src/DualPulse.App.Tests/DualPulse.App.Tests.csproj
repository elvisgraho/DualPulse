<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\DualPulse.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>DualPulse.App.Tests</RootNamespace>
    <!-- FakeHidTransport is shared with Core.Tests; members only Core.Tests uses look unassigned here. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\DualPulse.Core.Tests\FakeHidTransport.cs" Link="Shared\FakeHidTransport.cs" />
    <Compile Include="..\DualPulse.Core.Tests\TestReports.cs" Link="Shared\TestReports.cs" />
    <None Include="..\DualPulse.Core.Tests\Fixtures\*.hex" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DualPulse.App\DualPulse.App.csproj" />
  </ItemGroup>
</Project>
